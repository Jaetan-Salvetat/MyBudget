# Les modeles embarques dans l'app, et d'ou vient chacun.
#
# Une ligne par modele : <id>|<motif d'asset>|<source d'entrainement>
#
# Le motif porte %s a la place de la version — « v9 », le prefixe compris ; c'est lui qui nomme l'asset
# dans assets/models/, dans la release GitHub et dans lock.env. Un nom
# versionne n'est pas cosmetique : le cache du plugin ONNX et le manifeste
# des assets s'indexent dessus, republier sous le meme nom laisserait les
# installations sur l'ancien modele.
#
# La source est le fichier produit par l'entrainement. Absente au moment de
# publier, le modele est simplement reporte sous la nouvelle version : tous
# les modeles avancent ensemble, meme ceux qu'on n'a pas reentraines.
#
# `tokenizer` n'a pas de source directe : il est genere depuis le tokenizer
# d'entrainement par tool/models/build_tokenizer_asset.dart.
MODELS=(
  "quick_add|model_%s.onnx|ml/classifier/output/best/model.onnx"
  "tokenizer|tokenizer_%s.bin|"
  "line_roles|line_roles_%s.json|ml/scan/research/models/line_roles.json"
  "label_link|label_link_%s.json|ml/scan/research/models/label_link.json"
  "label_span|label_span_%s.json|ml/scan/research/models/label_span.json"
  "store_gazetteer|store_gazetteer_%s.json|ml/scan/research/models/store_gazetteer.json"
)

# Le tokenizer binaire se regenere depuis le tokenizer HuggingFace de
# l'entrainement. La source est archivee dans la release : c'est elle qui
# permet de le reconstruire.
TOKENIZER_SOURCE_DEFAULT=ml/classifier/output/best/tokenizer.json

REPOSITORY=Jaetan-Salvetat/MyBudget
ASSETS_DIR=assets/models
